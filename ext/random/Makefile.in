srcdir       = @srcdir@
top_builddir = @top_builddir@
top_srcdir   = @top_srcdir@

CONFIG_GENERATED = Makefile
PREGENERATED =
XCLEANFILES = math--random--mt.c random/mt.sci \
	      math--random--xos.c random/xos.sci

include ../Makefile.ext

SCM_CATEGORY = math

LIBFILES = math--random--mt.$(SOEXT) \
	   math--random--xos.$(SOEXT)
SCMFILES = random/mt.sci random/xos.sci mt-random.scm

OBJECTS = $(math_random_mt_OBJECTS) \
	  $(math_random_xos_OBJECTS)

all : $(LIBFILES)

# math.random.mt
math_random_mt_OBJECTS = mt-random.$(OBJEXT) math--random--mt.$(OBJEXT)

math--random--mt.$(SOEXT) : $(math_random_mt_OBJECTS)
	$(MODLINK) math--random--mt.$(SOEXT) $(math_random_mt_OBJECTS) $(EXT_LIBGAUCHE) $(LIBS)

math--random--mt.c random/mt.sci : mt.scm
	$(PRECOMP) -e -P -o math--random--mt -i random/mt.sci $(srcdir)/mt.scm

# math.random.xos
math_random_xos_OBJECTS = math--random--xos.$(OBJEXT)

math--random--xos.$(SOEXT) : $(math_random_xos_OBJECTS)
	$(MODLINK) math--random--xos.$(SOEXT) $(math_random_xos_OBJECTS) $(EXT_LIBGAUCHE) $(LIBS)

math--random--xos.c random/xos.sci : xos.scm
	$(PRECOMP) -e -P -o math--random--xos -i random/xos.sci $(srcdir)/xos.scm

install : install-std
